[core]
  editor = vim
  pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    side-by-side = true
    line-numbers = true

[merge]
    conflictStyle = zdiff3

[user]
	email = stycewski@gmail.com
	name = Paweł Styczewski

[color]
	ui = true

[init]
	defaultBranch = master

[safe]
	directory = /storage/doku

[alias]
	# Tworzy archiwum ZIP z aktualnego stanu (HEAD)
	zip = "!f() { git archive --format=zip --output=\"${1:-archive}.zip\" HEAD; }; f"

	# Tworzy skompresowane archiwum TAR.GZ z aktualnego stanu (HEAD)
	tar = "!f() { git archive --format=tar.gz --output=\"${1:-archive}.tar.gz\" HEAD; }; f"
