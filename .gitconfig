[core]
  editor = vim
  pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    side-by-side = true
    line-numbers = true

[merge]
    conflictStyle = zdiff3

[user]
	email = stycewski@gmail.com
	name = Paweł Styczewski

[color]
	ui = true

[init]
	defaultBranch = master

